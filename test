#!/usr/bin/env runghc

import System.Environment (getArgs)
import System.Process     (callCommand)
import Control.Monad      (forM_)
import Text.Printf        (printf)

main :: IO ()
main = getArgs >>= handleArgs

handleArgs :: [String] -> IO ()
handleArgs [f, t] =
    let from = read @Int f
        to   = read @Int t
     in forM_ [from..to] $ \i -> do
            let cmd = printf "cabal run kelleur -- %d" i
            putStrLn $ "\x1b[7mRunning: " ++ cmd ++ "\x1b[0m"
            callCommand cmd

handleArgs _ = printHelp

printHelp :: IO ()
printHelp = putStrLn "usage: ./test <from> <to>"
